{
  "name": "py-flowtoken-parity-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "build:oracle": "esbuild tests/oracle.js --bundle --format=esm --platform=browser --minify --outfile=.local/oracle.js",
    "test": "npm run build:runtime && npm run test:parity && npm run test:frameworks",
    "test:parity": "npm run build:oracle && node tests/browser.mjs",
    "test:frameworks": "node tests/frameworks.mjs",
    "build:runtime": "esbuild browser/index.js --bundle --format=esm --platform=browser --minify --legal-comments=eof --outfile=src/py_flowtoken/static/py_flowtoken/flowtoken.js"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "0.25.5",
    "flowtoken": "1.0.40",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
